# Bros and Subs · backend — variables de entorno
# Copiar a .env.local y rellenar. Las KAPSO_*, SUPABASE_* y GEMINI_* se validan
# al arranque con Zod (src/lib/env.ts) — si falta una, el server falla.

# --- Kapso (WhatsApp Cloud API) ---
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_PHONE_NUMBER_ID=

# --- Supabase ---
# URL del proyecto, ej: https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — segura para compartir; respeta RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key — bypasea RLS. SOLO server. Nunca exponer al browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (fallback del bot) ---
GEMINI_API_KEY=
# Opcional (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --- Origenes / Checkout web ---
# Origen propio del backend (para construir el paymentLink mock de Wompi).
# No está en el schema Zod: se lee con process.env y cae a http://localhost:3000.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Origen de la tienda web (frontend Vite). Con esto el backend arma el link
# {STOREFRONT_ORIGIN}/pedir?orderId=...&userId=... y habilita CORS hacia la tienda.
# En dev: el front corre en http://localhost:5173.
STOREFRONT_ORIGIN=http://localhost:5173
# Orígenes EXTRA permitidos para CORS (lista separada por comas). Útil para
# probar el panel/tienda en local contra el backend desplegado, o agregar
# dominios. localhost:5173 y 127.0.0.1:5173 ya están permitidos por defecto.
# Ej: EXTRA_CORS_ORIGINS=http://localhost:4173,https://mi-panel.vercel.app
EXTRA_CORS_ORIGINS=
# Vencimiento por defecto del carrito borrador, en minutos (default 30).
CHECKOUT_TTL_MINUTES=30

# --- Cron (pg_cron + pg_net) ---
# Secreto que valida el header x-cron-secret en /api/cron/*. Debe coincidir con
# el app.cron_secret configurado en Supabase (ver supabase/migrations/0007 y 0009).
CRON_SECRET=

# --- Wompi (Widget Checkout Web) ---
# `mock` (default) → flujo con /wompi/checkout/[orderId] simulado.
# `real`            → POST /pay devuelve widgetConfig firmado; frontend usa el
#                     Widget oficial https://checkout.wompi.co/widget.js
# Keys en https://comercios.wompi.co (Developers → API keys / Secrets).
WOMPI_MODE=mock
WOMPI_API_BASE=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Google Maps (Geocoding server-side · Tarea 2) ---
# Key del backend con la Geocoding API habilitada + billing. Convierte el texto
# de dirección del cliente en coordenadas para validar la zona de cobertura.
# Opcional: si falta, el bot cae al camino manual de selección de zona.
GOOGLE_MAPS_API_KEY=
