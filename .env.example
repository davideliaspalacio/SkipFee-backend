# Bros and Subs · backend — variables de entorno
# Copiar a .env.local y rellenar. Las KAPSO_*, SUPABASE_* y GEMINI_* se validan
# al arranque con Zod (src/lib/env.ts) — si falta una, el server falla.

# --- Kapso (WhatsApp Cloud API) ---
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_PHONE_NUMBER_ID=

# --- Supabase ---
# URL del proyecto, ej: https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — segura para compartir; respeta RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key — bypasea RLS. SOLO server. Nunca exponer al browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (fallback del bot) ---
GEMINI_API_KEY=
# Opcional (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --- Origenes / Checkout web ---
# Origen propio del backend (para construir el paymentLink mock de Wompi).
# No está en el schema Zod: se lee con process.env y cae a http://localhost:3000.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Origen de la tienda web (frontend Vite). Con esto el backend arma el link
# {STOREFRONT_ORIGIN}/pedir?orderId=...&userId=... y habilita CORS hacia la tienda.
# En dev: el front corre en http://localhost:5173.
STOREFRONT_ORIGIN=http://localhost:5173
# Orígenes EXTRA permitidos para CORS (lista separada por comas). Útil para
# probar el panel/tienda en local contra el backend desplegado, o agregar
# dominios. localhost:5173 y 127.0.0.1:5173 ya están permitidos por defecto.
# ⚠️ Acá va el origen de la LANDING (website-skipfee) para que POST /api/leads
#    le responda CORS. Ej: EXTRA_CORS_ORIGINS=https://skipfee.co,http://localhost:3001
EXTRA_CORS_ORIGINS=
# Vencimiento por defecto del carrito borrador, en minutos (default 30).
CHECKOUT_TTL_MINUTES=30

# --- Discord (aviso de leads de /pre-registro) ---
# Webhook al que POST /api/leads avisa cada lead. Discord → Configuración del
# servidor → Integraciones → Webhooks → Nuevo webhook → elegí canal → Copiar URL.
# Opcional: si falta, el lead igual se guarda en Supabase (no se manda a Discord).
DISCORD_WEBHOOK_URL=

# Webhook (opcional) para avisar VISITAS a la demo del panel (POST /api/demo-visit).
# Si falta, cae a DISCORD_WEBHOOK_URL. Podés usar otro canal para separarlas.
DISCORD_DEMO_WEBHOOK_URL=

# --- Cron (pg_cron + pg_net) ---
# Secreto que valida el header x-cron-secret en /api/cron/*. Debe coincidir con
# el app.cron_secret configurado en Supabase (ver supabase/migrations/0007 y 0009).
CRON_SECRET=

# --- Wompi (Widget Checkout Web) ---
# `mock` (default) → flujo con /wompi/checkout/[orderId] simulado.
# `real`            → POST /pay devuelve widgetConfig firmado; frontend usa el
#                     Widget oficial https://checkout.wompi.co/widget.js
# Keys en https://comercios.wompi.co (Developers → API keys / Secrets).
WOMPI_MODE=mock
WOMPI_API_BASE=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Google Maps (Geocoding server-side · Tarea 2) ---
# Key del backend con la Geocoding API habilitada + billing. Convierte el texto
# de dirección del cliente en coordenadas para validar la zona de cobertura.
# Opcional: si falta, el bot cae al camino manual de selección de zona.
GOOGLE_MAPS_API_KEY=

# URL pública de ESTE backend, para webhooks entrantes de proveedores externos
# (Evolution). Debe resolver al backend, no al panel. En local: un túnel ngrok.
BACKEND_PUBLIC_URL=

# Servidor Evolution COMPARTIDO de Skipfee (WhatsApp no oficial por QR).
# Uno solo para todos los negocios; cada empresa es una instancia derivada de su slug.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=

# --- Registro público (autoservicio) ---
# Cloudflare Turnstile: captcha invisible, gratis e ilimitado en el plan estándar.
# Sin esto el registro funciona, pero queda sin su primera defensa anti-abuso.
TURNSTILE_SECRET_KEY=
# Origen del panel admin, para el enlace del correo de recuperación de contraseña.
PANEL_ORIGIN=

# Cifrado en reposo de las credenciales de terceros en `company_integrations`.
# 32 bytes en base64: openssl rand -base64 32
# Sin ella el backend arranca, pero guarda las credenciales en texto plano.
# ⚠️ Si se pierde, las credenciales cifradas no se pueden recuperar.
CREDENTIALS_KEY=

# Verificación de correo en el registro público ('true' para exigirla).
# Apagada mientras no haya servicio de envío de correos.
SIGNUP_REQUIRE_EMAIL_CONFIRMATION=false

# Altas permitidas por IP y hora en el registro público. 0 = sin límite.
# Vacío: 3 en producción, sin límite en desarrollo.
SIGNUP_MAX_POR_HORA=
